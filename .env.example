# Copiare in .env per lo sviluppo locale (mai committare .env).
# In alternativa usare .env.op con riferimenti 1Password e `npm run dev:op`.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dppdesigner"

# Stringa casuale di almeno 32 caratteri: `openssl rand -base64 32`
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email transazionali (verifica email, reset password). Se vuoto, le email vengono stampate in console.
RESEND_API_KEY=""
EMAIL_FROM="DPP Designer <noreply@example.com>"

# Assistente AI negli step di "Progetta" (Claude). Se vuoto, l'assistente è disattivato
# e gli utenti possono solo scrivere all'esperto.
ANTHROPIC_API_KEY=""

# Altri indirizzi da cui è consentito l'accesso, separati da virgola (es. dominio senza www)
TRUSTED_ORIGINS=""

# Protegge l'endpoint del job di conservazione dati (/api/cron/retention)
CRON_SECRET=""

# Utente admin creato dal seed
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""
